<Window x:Class="UrzadzeniaSImScottplot.okna.wyszukiwanie_wersji"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UrzadzeniaSImScottplot.okna"
                xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        mc:Ignorable="d"
        Title="wyszukiwanie_wersji" Height="450" Width="400">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="749*"/>
            <ColumnDefinition Width="51*"/>
        </Grid.ColumnDefinitions>
        <TabControl Grid.ColumnSpan="2">
            <TabItem Header="Najnowsza wersja">
                <Grid Background="White">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Background="#C9DABA">
                        <TextBlock Text="Wyszukuje ostatnią wersję urządzenia o podanym ID." VerticalAlignment="Center" Margin="20,10,20,10"/>
                    </Grid>

                    <Grid Grid.Row="1" Margin="20,50,20,10">
                        <xctk:IntegerUpDown x:Name="IdUrzadzenia1" HorizontalAlignment="Right" VerticalAlignment="Top" Height="20" Width="80" Maximum="{Binding maxId}" Minimum="0" Value="0" AllowTextInput="False" />
                        <TextBlock HorizontalAlignment="Left" TextWrapping="Wrap" Text="ID urządzenia" VerticalAlignment="Top"/>
                    </Grid>

                    <Grid Grid.Row="2" Margin="50,10,50,50" VerticalAlignment="Bottom">
                        <Button x:Name="Anuluj1" Content="Anuluj" Width="100" HorizontalAlignment="Left"  VerticalAlignment="Top" Click="Anuluj1_Click"/>
                        <Button x:Name="Przeslij1"  Content="Prześlij" Width="100" HorizontalAlignment="Right"  VerticalAlignment="Top" Click="Przeslij1_Click"/>
                    </Grid>


                </Grid>
            </TabItem>

            <TabItem Header="Wersja o id">
                <Grid Background="White">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Background="#C9DABA" >
                        <TextBlock Text="Wyszukuje wersje urządzenia o podanym ID." VerticalAlignment="Center" Margin="20,10,20,10"/>
                    </Grid>

                    <Grid Grid.Row="1" Margin="20,50,20,10">
                        <TextBlock HorizontalAlignment="Left" TextWrapping="Wrap" Text="ID urządzenia:" VerticalAlignment="Top"/>
                        <xctk:IntegerUpDown x:Name="IdUrzadzenia2" VerticalAlignment="Top" HorizontalAlignment="Right" Height="20" Width="80" Minimum="0" Maximum="{Binding maxId}" ValueChanged="IntegerUpDown_ValueChanged" Value="0" AllowTextInput="False"/>
                    </Grid>

                    <Grid Grid.Row="2" Margin="20,10,20,10">
                        <TextBlock HorizontalAlignment="Left" TextWrapping="Wrap" Text="ID wersji:" VerticalAlignment="Top"/>
                        <xctk:IntegerUpDown x:Name="idWersji" VerticalAlignment="Top" HorizontalAlignment="Right" Height="20" Width="80" Minimum="{Binding minVer}" Maximum="{Binding maxVer}" Value="0" AllowTextInput="False"/>
                    </Grid>

                    <Grid Grid.Row="3" Margin="50,10,50,50" VerticalAlignment="Bottom">
                        <Button x:Name="Anuluj2" Content="Anuluj" HorizontalAlignment="Left" VerticalAlignment="Top" Width="100" Click="Anuluj2_Click"/>
                        <Button x:Name="Przeslij2" Content="Prześlij" HorizontalAlignment="Right" VerticalAlignment="Top" Width="100" Click="Przeslij2_Click"/>
                    </Grid>

                </Grid>
            </TabItem>

            <TabItem Header="Z przedziału czasowego">
                <Grid Background="White">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Background="#C9DABA" >
                        <TextBlock HorizontalAlignment="Center" Margin="20,10,20,10" TextWrapping="Wrap" Text="Wyszukuje wszystkie wersje aktualne w podanym przedziale czasowym." VerticalAlignment="Top"/>
                    </Grid>

                    <Grid Grid.Row="1" Margin="20,50,20,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="4*"/>
                            <ColumnDefinition Width="3*"/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Grid.Column="0" HorizontalAlignment="Left" TextWrapping="Wrap" Text="Od:" VerticalAlignment="Top"/>
                        <xctk:DateTimePicker Grid.Column="1" x:Name="ui_poczatek" HorizontalAlignment="Right" Width="100" VerticalAlignment="Top" IsEnabled="{Binding poczatku_checkbox.IsChecked}"/>
                        <CheckBox x:Name="poczatku_checkbox" Grid.Column="2" Content="początku" Grid.Row="2" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="5,0,0,0" Click="poczatku_checkbox_Click"/>

                    </Grid>

                    <Grid Grid.Row="2" Margin="20,10,20,10">
                        
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="4*"/>
                            <ColumnDefinition Width="3*"/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>
                
                        <TextBlock Grid.Column="0" TextWrapping="Wrap" Text="Do:" VerticalAlignment="Top"/>
                        <xctk:DateTimePicker Margin="10,0,0,0" Grid.Column="1" x:Name="ui_koniec" VerticalAlignment="Top"  Width="100"  HorizontalAlignment="Right"/>
                        <CheckBox x:Name="konca_checkbox" Grid.Column="2" Content="końca" Grid.Row="2" VerticalAlignment="Top" Margin="5,0,0,0" HorizontalAlignment="Left" Click="konca_checkbox_Click"/>
                    </Grid>

                    <Grid Grid.Row="3" Margin="50,10,50,50" VerticalAlignment="Bottom">
                        <Button x:Name="Anuluj3" Content="Anuluj" Width="100" HorizontalAlignment="Left" VerticalAlignment="Top" Click="Anuluj3_Click"/>
                        <Button x:Name="Przeslij3" Content="Przeslij" Width="100" HorizontalAlignment="Right" VerticalAlignment="Top" Click="Przeslij3_Click"/>
                    </Grid>
                    
                </Grid>
            </TabItem>

        </TabControl>

    </Grid>
</Window>
