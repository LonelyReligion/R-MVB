<Window x:Class="UrzadzeniaSImScottplot.okna.wyszukiwanie_wersji"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UrzadzeniaSImScottplot.okna"
                xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        mc:Ignorable="d"
        Title="wyszukiwanie_wersji" Height="450" Width="800">
    <Grid>
        <TabControl>
            <TabItem Header="Najnowsza wersja">
                <Grid Background="White"/>
            </TabItem>
            
            <TabItem Header="Wersja o id">
                <Grid Background="White"/>
            </TabItem>
            
            <TabItem Header="Z przedziału czasowego">
                <Grid Background="White">
                    <xctk:IntegerUpDown x:Name="id_urzadzenia" ValueChanged="id_urzadzenia_ValueChanged" Grid.Column="1" Height="20" Width="80" Grid.Row="0" Minimum="0" Value="0" Maximum="{Binding maxId}" AllowTextInput="False"/>
                    <DatePicker HorizontalAlignment="Left" Margin="151,167,0,0" VerticalAlignment="Top"/>
                    <DatePicker HorizontalAlignment="Left" Margin="560,167,0,0" VerticalAlignment="Top"/>
                </Grid>
            </TabItem>
            
        </TabControl>

    </Grid>
</Window>
