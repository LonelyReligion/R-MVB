<Window x:Class="UrzadzeniaSImScottplot.okna.DodajUrzadzenia"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UrzadzeniaSImScottplot.okna"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        mc:Ignorable="d"
        Title="DodajUrzadzenia" Height="450" Width="400">
    <Grid>
        <TabControl>
            <TabItem Header="Losowe">
                <Grid Background="#FFE5E5E5">
                    <TextBlock Text="Podaj liczbę losowych urządzeń do dodania (na zielonym tle u góry)"/>
                    <xctk:IntegerUpDown x:Name="IdUrzadzenia1" HorizontalAlignment="Right" VerticalAlignment="Top" Height="20" Width="80" Maximum="100" Minimum="0" Value="0" AllowTextInput="True" />
                    <Grid Grid.Row="2" Margin="50,10,50,50" VerticalAlignment="Bottom">
                        <Button x:Name="Anuluj" Content="Anuluj" Width="100" HorizontalAlignment="Left"  VerticalAlignment="Top" Click="Anuluj1_Click"/>
                        <Button x:Name="Przeslij"  Content="Prześlij" Width="100" HorizontalAlignment="Right"  VerticalAlignment="Top" Click="Przeslij1_Click"/>
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem Header="Wpisz dane...">
                <Grid Background="#FFE5E5E5">
                    <TextBlock Text="Podaj współrzędne urządzenia do dodania (na zielonym tle u góry)"/>
                    <TextBlock Text="Długość:"/>
                    <TextBlock Text="Szerokość:"/>
                    <xctk:IntegerUpDown x:Name="dlugosc" HorizontalAlignment="Right" VerticalAlignment="Top" Height="20" Width="80" Maximum="100" Minimum="0" Value="0" AllowTextInput="True" />
                    <xctk:IntegerUpDown x:Name="szerokosc" HorizontalAlignment="Right" VerticalAlignment="Top" Height="20" Width="80" Maximum="100" Minimum="0" Value="0" AllowTextInput="True" />
                    <TextBlock Text="Uwaga, istnieje już urządzenie o takich współrzędnych. Podaj inne współrzędne i spróbuj ponownie."/>
                    <Grid Grid.Row="2" Margin="50,10,50,50" VerticalAlignment="Bottom">
                        <Button x:Name="Anuluj1" Content="Anuluj" Width="100" HorizontalAlignment="Left"  VerticalAlignment="Top" Click="Anuluj1_Click"/>
                        <Button x:Name="Przeslij1"  Content="Prześlij" Width="100" HorizontalAlignment="Right"  VerticalAlignment="Top" Click="Przeslij1_Click"/>
                        
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

    </Grid>
</Window>
