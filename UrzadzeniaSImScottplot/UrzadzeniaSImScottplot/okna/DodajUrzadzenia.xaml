<Window x:Class="UrzadzeniaSImScottplot.okna.DodajUrzadzenia"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UrzadzeniaSImScottplot.okna"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        mc:Ignorable="d"
        Title="DodajUrzadzenia" Height="450" Width="400">
    <Grid>
        <TabControl>
            <TabItem Header="Losowe">
                <Grid Background="White">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="101*"/>
                        <ColumnDefinition Width="293*"/>
                    </Grid.ColumnDefinitions>
                    
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>


                    <Grid Grid.Row="0" Background="#C9DABA" Grid.ColumnSpan="2">
                        <TextBlock HorizontalAlignment="Left" Margin="20,10,20,10" TextWrapping="Wrap" Text="Podaj liczbę losowych urządzeń do dodania." VerticalAlignment="Top"/>
                    </Grid>

                    <Grid Grid.Row="1" Margin="20,10,20,10" Grid.ColumnSpan="2">
                        <TextBlock Text="Liczba urządzeń:"></TextBlock>
                        <xctk:IntegerUpDown x:Name="IdUrzadzenia1" HorizontalAlignment="Right" VerticalAlignment="Top" Height="20" Width="80" Maximum="100" Minimum="1" Value="{Binding liczba_urzadzen}" AllowTextInput="True" />
                    </Grid>


                    <Grid Grid.Row="2" Margin="50,0,50,50" VerticalAlignment="Bottom" Grid.ColumnSpan="2">
                        <Button x:Name="Anuluj" Content="Anuluj" Width="100" HorizontalAlignment="Left"  VerticalAlignment="Top" Click="Anuluj_Click"/>
                        <Button x:Name="Przeslij0"  Content="Prześlij" Width="100" HorizontalAlignment="Right"  VerticalAlignment="Top" Click="Przeslij0_Click"/>
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem Header="Wpisz dane...">
                <Grid Background="White">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>


                    <Grid Grid.Row="0" Background="#C9DABA" Grid.ColumnSpan="2">
                        <TextBlock HorizontalAlignment="Left" Margin="20,10,20,10" TextWrapping="Wrap" Text="Podaj współrzędne urządzenia do dodania." VerticalAlignment="Top"/>
                    </Grid>


                    <Grid Grid.Row="1" Margin="20,10,20,10">
                        <TextBlock Text="Długość:"/>
                        <xctk:DecimalUpDown x:Name="dlugosc_spin" HorizontalAlignment="Right" VerticalAlignment="Top" Height="20" Width="80" Maximum="24.09" Minimum="14.07" DefaultValue="14.07" Value="{Binding dlugosc}" 
                                            Increment="0.01" AllowTextInput="False" AllowSpin="True"/>
                    </Grid>

                    <Grid Grid.Row="2" Margin="20,10,20,10">
                        <TextBlock Text="Szerokość:"/>
                        <xctk:DecimalUpDown x:Name="szerokosc_spin" HorizontalAlignment="Right" VerticalAlignment="Top" Height="20" Width="80" Maximum="54.50" Minimum="49"  DefaultValue="49" Value="{Binding szerokosc}" 
                                            Increment="0.01" AllowTextInput="False" AllowSpin="True"/>
                    </Grid>

                    <Grid Grid.Row="3" Margin="20,10,20,10" VerticalAlignment="Bottom">
                        <TextBlock Foreground="White" TextWrapping="WrapWithOverflow" Text="Uwaga, istnieje już urządzenie o takich współrzędnych. Podaj inne współrzędne i spróbuj ponownie."/>
                    </Grid>
                    
                    <Grid Grid.Row="4" Margin="50,10,50,50" VerticalAlignment="Bottom">
                        <Button x:Name="Anuluj1" Content="Anuluj" Width="100" HorizontalAlignment="Left"  VerticalAlignment="Top" Click="Anuluj_Click"/>
                        <Button x:Name="Przeslij1"  Content="Prześlij" Width="100" HorizontalAlignment="Right"  VerticalAlignment="Top" Click="Przeslij1_Click"/>
                    </Grid>
                    
                </Grid>
            </TabItem>
        </TabControl>

    </Grid>
</Window>
