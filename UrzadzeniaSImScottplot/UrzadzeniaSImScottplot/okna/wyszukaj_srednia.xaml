<Window x:Class="UrzadzeniaSImScottplot.okna.wyszukaj_srednia"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UrzadzeniaSImScottplot"
        xmlns:kontrolki="clr-namespace:UrzadzeniaSImScottplot.kontrolki"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        mc:Ignorable="d"
        Title="wyszukaj_srednia" Height="460" Width="600">
    <Grid>
        <TabControl>
            <TabItem Header="Z pomiarów na określonej powierzchni">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>


                    <Grid Grid.Row="0" Background="#C9DABA">
                        <TextBlock HorizontalAlignment="Left" Margin="10,10,0,10" TextWrapping="Wrap" Text="Uzupełnij współrzędne prostokąta, dla którego chcesz obliczyć średnią z pomiarów." VerticalAlignment="Top"/>
                    </Grid>

                    <kontrolki:wybor_prostokata x:Name="prostkat" Margin="0,4,0,16" Grid.Row="1"/>

                    <Grid Grid.Row="2" Grid.RowSpan="2" VerticalAlignment="Bottom" Margin="0,0,0,20">
                        <Button x:Name="Anuluj1" HorizontalAlignment="Center" Content="Anuluj" Width="100" Height="20" Margin="0,0,300,0" VerticalAlignment="Bottom" Click="Anuluj_Click"/>
                        <Button x:Name="Przeslij1" HorizontalAlignment="Center" Content="Przeslij" Width="100" Height="20" Margin="300,0,0,0" VerticalAlignment="Bottom" Click="Przeslij1_Click"/>
                    </Grid>

                </Grid>
            </TabItem>
            <TabItem Header="Z pomiarów urządzenia">
                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Background="#C9DABA">
                        <TextBlock HorizontalAlignment="Left" Margin="10,10,0,10" TextWrapping="Wrap" Text="Uzupełnij ID urządzenia, dla którego chcesz obliczyć średnią z pomiarów." VerticalAlignment="Top"/>
                    </Grid>
                    
                    <Grid Grid.Row="1" VerticalAlignment="Center" Margin="50,0,50,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        <Label Content="Wybierz ID urządzenia:"  Grid.Column="0" />
                        <xctk:IntegerUpDown x:Name="id_urzadzenia" ValueChanged="id_urzadzenia_ValueChanged" Grid.Column="1" Height="20" Width="80" Grid.Row="0" Minimum="0" Value="0" Maximum="{Binding maxId}" AllowTextInput="False"/>

                    </Grid>

                    <Grid Grid.Row="2" Margin="50,0,90,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        <Label Content="Długość:" Grid.Column="0"/>
                        <Label x:Name="dlugosc" Grid.Column="1" HorizontalAlignment="Right"/>
                    </Grid>

                    <Grid Grid.Row="3" Margin="50,0,90,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        
                        <Label Content="Szerokość:" Grid.Column="0"/>
                        <Label x:Name="szerokosc" Grid.Column="1" HorizontalAlignment="Right"/>
                    </Grid>
                    
                    <Grid Grid.Row="4" VerticalAlignment="Bottom" Margin="0,0,0,20">
                        <Button x:Name="Anuluj2" Click="Anuluj_Click" HorizontalAlignment="Center" Content="Anuluj" Width="100" Height="20" Margin="0,0,300,0" VerticalAlignment="Center"/>
                        <Button x:Name="Przeslij2" Click="Przeslij2_Click" HorizontalAlignment="Center" Content="Przeslij" Width="100" Height="20" Margin="300,0,0,0" VerticalAlignment="Center"/>
                    </Grid>

                </Grid>
            </TabItem>
            <TabItem Header="Z pomiarów w okresie czasu">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Background="#C9DABA">
                        <TextBlock HorizontalAlignment="Left" Margin="10,10,0,10" TextWrapping="Wrap" Text="Uzupełnij ID urządzenia, dla którego chcesz obliczyć średnią z pomiarów." VerticalAlignment="Top"/>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,20,0,0" VerticalAlignment="Top">
                        <kontrolki:wybor_prostokata x:Name="prostkatv2"/>
                    </Grid>
                    
                    <Grid Grid.Row="2" VerticalAlignment="Center" Margin="50,20,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="4*"/>
                            <ColumnDefinition Width="3*"/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" HorizontalAlignment="Left" TextWrapping="Wrap" Text="Od:" VerticalAlignment="Top"/>
                        <xctk:DateTimePicker Grid.Column="1" x:Name="ui_poczatek" HorizontalAlignment="Right" Width="100" VerticalAlignment="Top" IsEnabled="{Binding poczatku_checkbox.IsChecked}"/>
                        <CheckBox x:Name="poczatku_checkbox" Grid.Column="2" Content="początku" Grid.Row="2" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="5,0,0,0" Click="poczatku_checkbox_Click"/>

                    </Grid>

                    <Grid Grid.Row="3" VerticalAlignment="Center" Margin="50,10,0,20">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="4*"/>
                            <ColumnDefinition Width="3*"/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" TextWrapping="Wrap" Text="Do:" VerticalAlignment="Top"/>
                        <xctk:DateTimePicker Margin="10,0,0,0" Grid.Column="1" x:Name="ui_koniec" VerticalAlignment="Top"  Width="100"  HorizontalAlignment="Right"/>
                        <CheckBox x:Name="konca_checkbox" Grid.Column="2" Content="końca" Grid.Row="2" VerticalAlignment="Top" Margin="5,0,0,0" HorizontalAlignment="Left" Click="konca_checkbox_Click" />
                    </Grid>
                    
                    <Grid Grid.Row="4" VerticalAlignment="Bottom" Margin="0,0,0,20">
                        <Button x:Name="Anuluj3" Click="Anuluj_Click" HorizontalAlignment="Center" Content="Anuluj" Width="100" Height="20" Margin="0,0,300,0" VerticalAlignment="Center"/>
                        <Button x:Name="Przeslij3" Click="Przeslij2_Click" HorizontalAlignment="Center" Content="Przeslij" Width="100" Height="20" Margin="300,0,0,0" VerticalAlignment="Center"/>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

    </Grid>
</Window>
