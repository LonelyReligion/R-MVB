<Window x:Class="UrzadzeniaSImScottplot.wyszukaj_srednia"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UrzadzeniaSImScottplot"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        mc:Ignorable="d"
        Title="wyszukaj_srednia" Height="380" Width="600">
    <Grid>
        <TabControl>
            <TabItem Header="Z pomiarów na określonej powierzchni">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="271*"/>
                        <ColumnDefinition Width="323*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="70"/>
                    </Grid.RowDefinitions>


                    <Grid Grid.Row="0" Background="#C9DABA" Grid.ColumnSpan="2" Margin="0,0,0,16">
                        <TextBlock HorizontalAlignment="Left" Margin="10,10,0,10" TextWrapping="Wrap" Text="Uzupełnij współrzędne prostokąta, dla którego chcesz obliczyć średnią z pomiarów." VerticalAlignment="Top"/>
                    </Grid>

                    <local:wybor_prostokata x:Name="prostkat" Margin="0,4,0,16" Grid.Row="1" Grid.ColumnSpan="2"/>

                    <Grid Grid.Row="1" Margin="0,204,0,26" Grid.ColumnSpan="2" Grid.RowSpan="2">
                        <Button x:Name="Anuluj1" HorizontalAlignment="Center" Content="Anuluj" Width="100" Height="20" Margin="0,0,300,0" VerticalAlignment="Center" Click="Anuluj_Click"/>
                        <Button x:Name="Przeslij1" HorizontalAlignment="Center" Content="Przeslij" Width="100" Height="20" Margin="300,0,0,0" VerticalAlignment="Center" Click="Przeslij1_Click"/>
                    </Grid>

                </Grid>
            </TabItem>
            <TabItem Header="Z pomiarów urządzenia">
                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" VerticalAlignment="Center"  Margin="100,50,200,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        <Label Content="Wybierz ID Urządzenia:"  Grid.Column="0" />
                        <xctk:IntegerUpDown x:Name="id_urzadzenia" ValueChanged="id_urzadzenia_ValueChanged" Grid.Column="1" Height="20" Width="80" Grid.Row="0" Minimum="0" Value="0" Maximum="{Binding maxId}" AllowTextInput="False"/>

                    </Grid>

                    <Grid Grid.Row="1" Margin="100,50,200,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        <Label Content="Długość:" Grid.Column="0"/>
                        <Label x:Name="dlugosc" Grid.Column="1"/>
                    </Grid>

                    <Grid Grid.Row="2" Margin="100,0,200,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        
                        <Label Content="Szerokość:" Grid.Column="0"/>
                        <Label x:Name="szerokosc" Grid.Column="1"/>
                    </Grid>
                    
                    <Grid Grid.Row="3">
                        <Button x:Name="Anuluj2" Click="Anuluj_Click" HorizontalAlignment="Center" Content="Anuluj" Width="100" Height="20" Margin="0,0,300,0" VerticalAlignment="Center"/>
                        <Button x:Name="Przeslij2" Click="Przeslij2_Click" HorizontalAlignment="Center" Content="Przeslij" Width="100" Height="20" Margin="300,0,0,0" VerticalAlignment="Center"/>
                    </Grid>

                </Grid>
            </TabItem>
        </TabControl>

    </Grid>
</Window>
