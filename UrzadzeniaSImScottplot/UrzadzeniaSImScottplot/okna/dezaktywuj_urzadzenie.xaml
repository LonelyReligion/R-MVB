<Window x:Class="UrzadzeniaSImScottplot.okna.dezaktywuj_urzadzenie"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UrzadzeniaSImScottplot.okna"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        mc:Ignorable="d"
        Title="dezaktywuj_urzadzenie" Height="450" Width="470">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="#C9DABA" >
            <TextBlock Text="Podaj ID urządzenia aby je aktywować lub dezaktywować." VerticalAlignment="Center" Margin="20,10,20,10"/>
        </Grid>

        <Grid Grid.Row="1" Margin="20,10,20,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="ID urządzenia:" VerticalAlignment="Center"/>
            <xctk:IntegerUpDown Grid.Column="1" HorizontalAlignment="Right" x:Name="IdUrzadzenia" Height="20" Width="80" Minimum="0" Maximum="{Binding maxId}" ValueChanged="IdUrzadzenia_ValueChanged" Value="0" AllowTextInput="False"/>
        
        </Grid>

        <Grid Grid.Row="2" Margin="20,10,20,10">
            <DataGrid x:Name="Urzadzenie_DF" d:ItemsSource="{d:SampleData ItemCount=1}" CanUserAddRows="False"/>
        </Grid>

        <Grid Grid.Row="3" Margin="50,10,50,50" VerticalAlignment="Bottom">
            <Button x:Name="Anuluj" Content="Anuluj" Width="100" HorizontalAlignment="Left"  VerticalAlignment="Top" Click="Anuluj_Click"/>
            <Button x:Name="Zapisz"  Content="Zapisz" Width="100" HorizontalAlignment="Right"  VerticalAlignment="Top" Click="Zapisz_Click"/>
        </Grid>
        
        </Grid>
</Window>
