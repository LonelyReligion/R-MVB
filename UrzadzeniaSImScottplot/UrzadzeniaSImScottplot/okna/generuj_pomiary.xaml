<Window x:Class="UrzadzeniaSImScottplot.okna.generuj_pomiary"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UrzadzeniaSImScottplot.okna"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        mc:Ignorable="d"
        Title="generuj_pomiary" Height="300" Width="400">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="10,20,10,0">
            <TextBlock HorizontalAlignment="Left" TextWrapping="Wrap" VerticalAlignment="Top"><Run Text="Podaj ID"/><Run Language="pl-pl" Text=" Urzadzenia"/><LineBreak/><Run/></TextBlock>
            <xctk:IntegerUpDown VerticalAlignment="Top" HorizontalAlignment="Right" Height="20" Width="80" Minimum="0" />
        </Grid>

        <Grid Grid.Row="1" Margin="10,40,10,0" >
            <RadioButton Content="Podaj wartość pomiaru" HorizontalAlignment="Left" VerticalAlignment="Top" IsChecked="True" GroupName="RodzajGenerowania" x:Name="PodajWartosc"/>
            <xctk:DecimalUpDown VerticalAlignment="Top" HorizontalAlignment="Right" Height="20" Width="80" Minimum="-41.1" Maximum="40.5" IsEnabled="{Binding IsChecked, ElementName=PodajWartosc}" />
        </Grid>

        <Grid Grid.Row="2" Margin="10,10,10,0">
            <RadioButton Content="Podaj liczbę losowych pomiarów" HorizontalAlignment="Left"  VerticalAlignment="Top" IsChecked="False" GroupName="RodzajGenerowania" x:Name="PodajLiczbe"/>
            <xctk:IntegerUpDown HorizontalAlignment="Right" VerticalAlignment="Top" Height="20" Width="80" Minimum="1" Maximum="100" IsEnabled="{Binding IsChecked, ElementName=PodajLiczbe}" />
        </Grid>

        <Grid Grid.Row="3" Margin="10,10,10,0">
            <Button  Content="Anuluj" Width="100"  HorizontalAlignment="Left"  VerticalAlignment="Top" RenderTransformOrigin="-0.032,0.73"/>
            <Button  Content="Przeslij" Width="100" HorizontalAlignment="Right"  VerticalAlignment="Top"/>
        </Grid>
    </Grid>
</Window>
